{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "FunctionName": {
            "type": "string",
            "defaultValue": "JoeDefenderO365",
            "minLength": 1,
            "maxLength": 20,
            "metadata": {
                "description": "Base name of the Function App; a 3 character suffix is appended."
            }
        },
        "AppInsightsWorkspaceResourceID": {
            "type": "string",
            "minLength": 1,
            "metadata": {
                "description": "Resource ID of the Log Analytics workspace used by Application Insights ('Log Analytics workspace --> Properties --> Resource ID'), in the format '/subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/providers/Microsoft.OperationalInsights/workspaces/{workspaceName}'."
            }
        },
        "AzureClientID": {
            "type": "string",
            "minLength": 1,
            "metadata": {
                "description": "Enter Azure Client Id that you have created during app registration."
            }
        },
        "AzureClientSecret": {
            "type": "securestring",
            "minLength": 1,
            "metadata": {
                "description": "Enter Azure Client Secret that you have created during creating the client secret."
            }
        },
        "AzureTenantID": {
            "type": "string",
            "minLength": 1,
            "metadata": {
                "description": "Enter Azure Tenant Id of your Azure Active Directory."
            }
        },
        "JoeSandboxAPIKey": {
            "type": "securestring",
            "minLength": 1,
            "metadata": {
                "description": "Enter the Joe Sandbox API key."
            }
        },
        "JoeSandboxBaseURL": {
            "type": "string",
            "defaultValue": "https://jbxcloud.joesecurity.org",
            "minLength": 1,
            "metadata": {
                "description": "Joe Sandbox instance URL."
            }
        },
        "JoeSandboxAcceptTerms": {
            "type": "bool",
            "defaultValue": true,
            "metadata": {
                "description": "Accept the Joe Sandbox Terms and Conditions via the API."
            }
        },
        "JoeSandboxResubmit": {
            "type": "bool",
            "defaultValue": false,
            "metadata": {
                "description": "If true, always submit the email even when a finished Joe Sandbox analysis of the same EML (SHA-256) already exists."
            }
        },
        "JoeSandboxAnalysisJobTimeout": {
            "type": "int",
            "defaultValue": 30,
            "minValue": 1,
            "maxValue": 55,
            "metadata": {
                "description": "Maximum minutes to wait for a Joe Sandbox analysis to finish within one run (1-55). Unfinished submissions are picked up by the next run."
            }
        },
        "JoeSandboxPollIntervalSeconds": {
            "type": "int",
            "defaultValue": 30,
            "minValue": 5,
            "maxValue": 300,
            "metadata": {
                "description": "Seconds between Joe Sandbox submission status checks (5-300)."
            }
        },
        "JoeSandboxAPIMaxRetry": {
            "type": "int",
            "defaultValue": 5,
            "minValue": 1,
            "maxValue": 10,
            "metadata": {
                "description": "Number of retries for failed Joe Sandbox API requests (1-10)."
            }
        },
        "JoeSandboxAPIRequestTimeoutSeconds": {
            "type": "int",
            "defaultValue": 60,
            "minValue": 5,
            "maxValue": 600,
            "metadata": {
                "description": "Timeout in seconds for a single Joe Sandbox API request (5-600)."
            }
        },
        "AlertPollingIntervalInMinutes": {
            "type": "string",
            "defaultValue": "10",
            "allowedValues": [
                "5",
                "10",
                "15",
                "20",
                "30",
                "60"
            ],
            "metadata": {
                "description": "Interval in minutes between connector runs."
            }
        },
        "AlertSeverities": {
            "type": "string",
            "defaultValue": "informational,low,medium,high",
            "minLength": 1,
            "metadata": {
                "description": "Only alerts with these severities are processed. Comma separated list of: unknown, informational, low, medium, high."
            }
        },
        "InitialLookbackMinutes": {
            "type": "int",
            "defaultValue": 60,
            "minValue": 1,
            "maxValue": 43200,
            "metadata": {
                "description": "Lookback window in minutes for the first run (1-43200)."
            }
        },
        "AlertOverlapMinutes": {
            "type": "int",
            "defaultValue": 15,
            "minValue": 0,
            "maxValue": 1440,
            "metadata": {
                "description": "Minutes each run overlaps the previous one so late-arriving alerts are not missed (0-1440)."
            }
        },
        "IncidentTagsEnabled": {
            "type": "bool",
            "defaultValue": true,
            "metadata": {
                "description": "If true, Joe Sandbox verdict tags are added to the related Microsoft Defender incidents."
            }
        },
        "IncidentCommentsEnabled": {
            "type": "bool",
            "defaultValue": true,
            "metadata": {
                "description": "If true, the Joe Sandbox analysis result is also added as a comment to the related Microsoft Defender incidents."
            }
        },
        "IndicatorImportEnabled": {
            "type": "bool",
            "defaultValue": true,
            "metadata": {
                "description": "If true, indicators (IOCs) from Joe Sandbox analyses are created in Microsoft Defender. This feature is only available if Microsoft Defender for Endpoint is enabled in the tenant."
            }
        },
        "IndicatorVerdicts": {
            "type": "string",
            "defaultValue": "malicious,suspicious",
            "allowedValues": [
                "malicious,suspicious",
                "malicious",
                "suspicious"
            ],
            "metadata": {
                "description": "Joe Sandbox verdicts for which indicators are created in Microsoft Defender."
            }
        },
        "IndicatorLifetimeDays": {
            "type": "int",
            "defaultValue": 30,
            "minValue": 1,
            "maxValue": 3650,
            "metadata": {
                "description": "Number of days the indicator remains valid (1-3650)."
            }
        },
        "MaliciousNetworkAction": {
            "type": "string",
            "defaultValue": "Block",
            "allowedValues": [
                "Allowed",
                "Audit",
                "Block",
                "BlockAndRemediate",
                "Warn"
            ],
            "metadata": {
                "description": "Action for IP address, domain and URL indicators from malicious analyses."
            }
        },
        "SuspiciousNetworkAction": {
            "type": "string",
            "defaultValue": "Audit",
            "allowedValues": [
                "Allowed",
                "Audit",
                "Block",
                "BlockAndRemediate",
                "Warn"
            ],
            "metadata": {
                "description": "Action for IP address, domain and URL indicators from suspicious analyses."
            }
        },
        "MaliciousFileAction": {
            "type": "string",
            "defaultValue": "Block",
            "allowedValues": [
                "Allowed",
                "Audit",
                "Block",
                "BlockAndRemediate",
                "Warn"
            ],
            "metadata": {
                "description": "Action for file hash indicators from malicious analyses."
            }
        },
        "SuspiciousFileAction": {
            "type": "string",
            "defaultValue": "Audit",
            "allowedValues": [
                "Allowed",
                "Audit",
                "Block",
                "BlockAndRemediate",
                "Warn"
            ],
            "metadata": {
                "description": "Action for file hash indicators from suspicious analyses."
            }
        },
        "IndicatorAlertsEnabled": {
            "type": "bool",
            "defaultValue": false,
            "metadata": {
                "description": "True if Defender should generate an alert when an indicator is hit. Always on for the Audit action."
            }
        },
        "MicrosoftRetryCount": {
            "type": "int",
            "defaultValue": 3,
            "minValue": 0,
            "maxValue": 10,
            "metadata": {
                "description": "Number of retries for failed Microsoft Graph / Defender API requests (0-10)."
            }
        },
        "MicrosoftRetryDelaySeconds": {
            "type": "int",
            "defaultValue": 60,
            "minValue": 1,
            "maxValue": 600,
            "metadata": {
                "description": "Initial delay in seconds between Microsoft API retries (1-600)."
            }
        },
        "MicrosoftHttpTimeoutSeconds": {
            "type": "int",
            "defaultValue": 120,
            "minValue": 5,
            "maxValue": 600,
            "metadata": {
                "description": "Timeout in seconds for a single Microsoft API request (5-600)."
            }
        },
        "FunctionPackageUri": {
            "type": "string",
            "defaultValue": "https://github.com/joesecurity/Joe-Sandbox-Microsoft-Defender-Office365/raw/refs/heads/main/FunctionApp/released-package.zip",
            "minLength": 1,
            "metadata": {
                "description": "Public HTTPS URI of the Function App deployment ZIP."
            }
        }
    },
    "variables": {
        "FunctionName": "[concat(toLower(parameters('FunctionName')), take(uniqueString(resourceGroup().id), 3))]",
        "StorageAccount": "[concat('joestorageo365', take(uniqueString(resourceGroup().id), 3))]",
        "StorageRoleDefinitionId": "b7e6dc6d-f1e8-4753-8033-0f276bb0955b",
        "DeploymentContainerName": "joestorageo365container",
        "StateContainerName": "joesandbox-defender-o365-state",
        "StorageSuffix": "[environment().suffixes.storage]",
        "PollingMap": {
            "5": "0 */5 * * * *",
            "10": "0 */10 * * * *",
            "15": "0 */15 * * * *",
            "20": "0 */20 * * * *",
            "30": "0 */30 * * * *",
            "60": "0 0 * * * *"
        },
        "Polling": "[variables('PollingMap')[parameters('AlertPollingIntervalInMinutes')]]"
    },
    "resources": [
        {
            "type": "Microsoft.Insights/components",
            "apiVersion": "2020-02-02",
            "name": "[variables('FunctionName')]",
            "location": "[resourceGroup().location]",
            "kind": "web",
            "properties": {
                "Application_Type": "web",
                "WorkspaceResourceId": "[parameters('AppInsightsWorkspaceResourceID')]"
            }
        },
        {
            "type": "Microsoft.Storage/storageAccounts",
            "apiVersion": "2023-05-01",
            "name": "[variables('StorageAccount')]",
            "location": "[resourceGroup().location]",
            "kind": "StorageV2",
            "sku": {
                "name": "Standard_LRS"
            },
            "properties": {
                "minimumTlsVersion": "TLS1_2",
                "supportsHttpsTrafficOnly": true,
                "defaultToOAuthAuthentication": true,
                "allowBlobPublicAccess": false
            }
        },
        {
            "type": "Microsoft.Storage/storageAccounts/blobServices",
            "apiVersion": "2023-05-01",
            "name": "[format('{0}/{1}', variables('StorageAccount'), 'default')]",
            "dependsOn": [
                "[resourceId('Microsoft.Storage/storageAccounts', variables('StorageAccount'))]"
            ]
        },
        {
            "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
            "apiVersion": "2023-05-01",
            "name": "[format('{0}/{1}/{2}', variables('StorageAccount'), 'default', variables('DeploymentContainerName'))]",
            "properties": {
                "publicAccess": "None"
            },
            "dependsOn": [
                "[resourceId('Microsoft.Storage/storageAccounts/blobServices', variables('StorageAccount'), 'default')]"
            ]
        },
        {
            "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
            "apiVersion": "2023-05-01",
            "name": "[format('{0}/{1}/{2}', variables('StorageAccount'), 'default', variables('StateContainerName'))]",
            "properties": {
                "publicAccess": "None"
            },
            "dependsOn": [
                "[resourceId('Microsoft.Storage/storageAccounts/blobServices', variables('StorageAccount'), 'default')]"
            ]
        },
        {
            "type": "Microsoft.Web/serverfarms",
            "apiVersion": "2023-12-01",
            "name": "[variables('FunctionName')]",
            "location": "[resourceGroup().location]",
            "kind": "functionapp",
            "sku": {
                "tier": "FlexConsumption",
                "name": "FC1"
            },
            "properties": {
                "reserved": true
            }
        },
        {
            "type": "Microsoft.Web/sites",
            "apiVersion": "2023-12-01",
            "name": "[variables('FunctionName')]",
            "location": "[resourceGroup().location]",
            "kind": "functionapp,linux",
            "identity": {
                "type": "SystemAssigned"
            },
            "properties": {
                "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('FunctionName'))]",
                "httpsOnly": true,
                "functionAppConfig": {
                    "deployment": {
                        "storage": {
                            "type": "blobContainer",
                            "value": "[concat(reference(resourceId('Microsoft.Storage/storageAccounts', variables('StorageAccount'))).primaryEndpoints.blob, variables('DeploymentContainerName'))]",
                            "authentication": {
                                "type": "SystemAssignedIdentity"
                            }
                        }
                    },
                    "scaleAndConcurrency": {
                        "maximumInstanceCount": 40,
                        "instanceMemoryMB": 2048
                    },
                    "runtime": {
                        "name": "python",
                        "version": "3.11"
                    }
                },
                "siteConfig": {
                    "minTlsVersion": "1.2",
                    "appSettings": [
                        {
                            "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
                            "value": "[reference(resourceId('Microsoft.Insights/components', variables('FunctionName')), '2020-02-02').ConnectionString]"
                        },
                        {
                            "name": "AzureWebJobsStorage",
                            "value": "[concat('DefaultEndpointsProtocol=https;AccountName=', variables('StorageAccount'), ';AccountKey=', listKeys(resourceId('Microsoft.Storage/storageAccounts', variables('StorageAccount')), '2023-05-01').keys[0].value, ';EndpointSuffix=', variables('StorageSuffix'))]"
                        },
                        {
                            "name": "AzureClientID",
                            "value": "[parameters('AzureClientID')]"
                        },
                        {
                            "name": "AzureClientSecret",
                            "value": "[parameters('AzureClientSecret')]"
                        },
                        {
                            "name": "AzureTenantID",
                            "value": "[parameters('AzureTenantID')]"
                        },
                        {
                            "name": "JoeSandboxAPIKey",
                            "value": "[parameters('JoeSandboxAPIKey')]"
                        },
                        {
                            "name": "JoeSandboxBaseURL",
                            "value": "[parameters('JoeSandboxBaseURL')]"
                        },
                        {
                            "name": "JoeSandboxAcceptTerms",
                            "value": "[string(parameters('JoeSandboxAcceptTerms'))]"
                        },
                        {
                            "name": "JoeSandboxResubmit",
                            "value": "[string(parameters('JoeSandboxResubmit'))]"
                        },
                        {
                            "name": "JoeSandboxAnalysisJobTimeout",
                            "value": "[string(parameters('JoeSandboxAnalysisJobTimeout'))]"
                        },
                        {
                            "name": "JoeSandboxPollIntervalSeconds",
                            "value": "[string(parameters('JoeSandboxPollIntervalSeconds'))]"
                        },
                        {
                            "name": "JoeSandboxAPIMaxRetry",
                            "value": "[string(parameters('JoeSandboxAPIMaxRetry'))]"
                        },
                        {
                            "name": "JoeSandboxAPIRequestTimeoutSeconds",
                            "value": "[string(parameters('JoeSandboxAPIRequestTimeoutSeconds'))]"
                        },
                        {
                            "name": "AlertSeverities",
                            "value": "[parameters('AlertSeverities')]"
                        },
                        {
                            "name": "InitialLookbackMinutes",
                            "value": "[string(parameters('InitialLookbackMinutes'))]"
                        },
                        {
                            "name": "AlertOverlapMinutes",
                            "value": "[string(parameters('AlertOverlapMinutes'))]"
                        },
                        {
                            "name": "IncidentTagsEnabled",
                            "value": "[string(parameters('IncidentTagsEnabled'))]"
                        },
                        {
                            "name": "IncidentCommentsEnabled",
                            "value": "[string(parameters('IncidentCommentsEnabled'))]"
                        },
                        {
                            "name": "IndicatorImportEnabled",
                            "value": "[string(parameters('IndicatorImportEnabled'))]"
                        },
                        {
                            "name": "IndicatorVerdicts",
                            "value": "[parameters('IndicatorVerdicts')]"
                        },
                        {
                            "name": "IndicatorLifetimeDays",
                            "value": "[string(parameters('IndicatorLifetimeDays'))]"
                        },
                        {
                            "name": "MaliciousNetworkAction",
                            "value": "[parameters('MaliciousNetworkAction')]"
                        },
                        {
                            "name": "SuspiciousNetworkAction",
                            "value": "[parameters('SuspiciousNetworkAction')]"
                        },
                        {
                            "name": "MaliciousFileAction",
                            "value": "[parameters('MaliciousFileAction')]"
                        },
                        {
                            "name": "SuspiciousFileAction",
                            "value": "[parameters('SuspiciousFileAction')]"
                        },
                        {
                            "name": "IndicatorAlertsEnabled",
                            "value": "[string(parameters('IndicatorAlertsEnabled'))]"
                        },
                        {
                            "name": "MicrosoftRetryCount",
                            "value": "[string(parameters('MicrosoftRetryCount'))]"
                        },
                        {
                            "name": "MicrosoftRetryDelaySeconds",
                            "value": "[string(parameters('MicrosoftRetryDelaySeconds'))]"
                        },
                        {
                            "name": "MicrosoftHttpTimeoutSeconds",
                            "value": "[string(parameters('MicrosoftHttpTimeoutSeconds'))]"
                        },
                        {
                            "name": "Polling",
                            "value": "[variables('Polling')]"
                        }
                    ]
                }
            },
            "dependsOn": [
                "[resourceId('Microsoft.Web/serverfarms', variables('FunctionName'))]",
                "[resourceId('Microsoft.Storage/storageAccounts/blobServices/containers', variables('StorageAccount'), 'default', variables('DeploymentContainerName'))]",
                "[resourceId('Microsoft.Insights/components', variables('FunctionName'))]"
            ]
        },
        {
            "type": "Microsoft.Authorization/roleAssignments",
            "apiVersion": "2022-04-01",
            "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', variables('StorageAccount')), resourceId('Microsoft.Web/sites', variables('FunctionName')), variables('StorageRoleDefinitionId'))]",
            "scope": "[resourceId('Microsoft.Storage/storageAccounts', variables('StorageAccount'))]",
            "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('StorageRoleDefinitionId'))]",
                "principalId": "[reference(resourceId('Microsoft.Web/sites', variables('FunctionName')), '2023-12-01', 'Full').identity.principalId]",
                "principalType": "ServicePrincipal"
            },
            "dependsOn": [
                "[resourceId('Microsoft.Storage/storageAccounts', variables('StorageAccount'))]",
                "[resourceId('Microsoft.Web/sites', variables('FunctionName'))]"
            ]
        },
        {
            "type": "Microsoft.Resources/deploymentScripts",
            "apiVersion": "2020-10-01",
            "name": "WaitSection",
            "location": "[resourceGroup().location]",
            "dependsOn": [
                "[resourceId('Microsoft.Web/sites', variables('FunctionName'))]",
                "[extensionResourceId(resourceId('Microsoft.Storage/storageAccounts', variables('StorageAccount')), 'Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.Storage/storageAccounts', variables('StorageAccount')), resourceId('Microsoft.Web/sites', variables('FunctionName')), variables('StorageRoleDefinitionId')))]"
            ],
            "kind": "AzurePowerShell",
            "properties": {
                "azPowerShellVersion": "7.0",
                "scriptContent": "start-sleep -Seconds 30",
                "cleanupPreference": "Always",
                "retentionInterval": "PT1H"
            }
        },
        {
            "type": "Microsoft.Web/sites/extensions",
            "apiVersion": "2023-12-01",
            "name": "[format('{0}/{1}', variables('FunctionName'), 'onedeploy')]",
            "dependsOn": [
                "[resourceId('Microsoft.Resources/deploymentScripts', 'WaitSection')]"
            ],
            "properties": {
                "packageUri": "[parameters('FunctionPackageUri')]",
                "remoteBuild": true
            }
        }
    ]
}
